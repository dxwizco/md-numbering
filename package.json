{
  "name": "md-numbering",
  "displayName": "Markdown Numbering",
  "description": "Automatically number Markdown headings based on their logical hierarchy.",
  "version": "0.1.0",
  "publisher": "DXWIZ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxwizco/md-numbering.git"
  },
  "bugs": {
    "url": "https://github.com/dxwizco/md-numbering/issues"
  },
  "homepage": "https://github.com/dxwizco/md-numbering#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "keywords": [
    "markdown",
    "heading",
    "numbering",
    "outline",
    "documentation",
    "formatting",
    "table of contents"
  ],
  "categories": [
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:md-numbering.numberHeadings",
    "onCommand:md-numbering.removeNumbering"
  ],
  "contributes": {
    "commands": [
      {
        "command": "md-numbering.numberHeadings",
        "title": "Markdown Numbering: Add Heading Numbers"
      },
      {
        "command": "md-numbering.removeNumbering",
        "title": "Markdown Numbering: Remove Heading Numbers"
      }
    ],
    "configuration": {
      "title": "Markdown Numbering",
      "properties": {
        "md-numbering.startLevel": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 6,
          "description": "Heading level at which Markdown numbering starts. Selecting '1' numbers from H1, '2' starts from H2, and so on."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
